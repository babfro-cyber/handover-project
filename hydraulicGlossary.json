{
  "meta": {
    "name": "NumerHyd hydraulic glossary v1",
    "purpose": "Glossaire assisté pour correction de transcription, relances métier et génération de fiches. Ce n’est pas un modèle entraîné.",
    "source": "Cours composants hydrauliques sur blocs forés + questions Gatien",
    "language": "fr-FR"
  },
  "transcriptionCorrectionPolicy": {
    "principles": [
      "Corriger uniquement les erreurs probables liées au vocabulaire hydraulique.",
      "Ne pas reformuler le fond de la réponse.",
      "Conserver les hésitations utiles et les incertitudes techniques.",
      "Signaler les corrections incertaines plutôt que les appliquer silencieusement.",
      "Ne jamais inventer une référence technique absente de la transcription."
    ],
    "confidenceLabels": [
      "certain",
      "probable",
      "incertain"
    ]
  },
